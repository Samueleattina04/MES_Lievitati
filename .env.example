APP_NAME="MES Lievitati"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# PRODUZIONE (IIS): OBBLIGATORIO https:// per far funzionare i Service Worker / PWA (§2-bis.2).
APP_URL=https://mes.aziendainterna.local

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database applicativo MES (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mes_lievitati
DB_USERNAME=mes_app
DB_PASSWORD=

# --- Database gestionale sorgente (SQL Server, Passepartout/Mexal) SOLA LETTURA ---
# L'utente DEVE avere solo db_datareader (§4.2). Richiede estensioni PHP sqlsrv/pdo_sqlsrv (§2-bis.1).
GESTIONALE_DB_HOST=
GESTIONALE_DB_PORT=1433
GESTIONALE_DB_DATABASE=
GESTIONALE_DB_USERNAME=
GESTIONALE_DB_PASSWORD=
GESTIONALE_DB_ENCRYPT=yes
GESTIONALE_DB_TRUST_CERT=true

# --- Configurazione MES ---
# 'sqlsrv' in produzione; 'fixture' solo per sviluppo/test senza gestionale.
MES_BOM_ADAPTER=sqlsrv
MES_TOLLERANZA_MULTILOTTO=0.01
MES_FASE_FERMA_ORE=8

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# PRODUZIONE HTTPS: true (cookie di sessione con flag Secure, §2-bis.2)
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="mes@lievitati.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
