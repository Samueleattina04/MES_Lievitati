<?xml version="1.0" encoding="UTF-8"?>
<!--
  web.config per la pubblicazione di Laravel su IIS (Windows Server) - §2-bis.
  Equivalente del .htaccess di Apache: NON e' generato automaticamente da IIS.

  PREREQUISITI DI AMBIENTE (attivita' di infrastruttura, non applicativa):
    - Modulo FastCGI IIS abilitato con php-cgi.exe (PHP Manager for IIS consigliato).
    - Modulo "URL Rewrite" di IIS installato (necessario per le regole <rewrite> qui sotto).
    - Estensioni PHP: pdo_sqlsrv, sqlsrv (gestionale), mbstring, openssl, pdo_mysql, fileinfo, ecc.
    - Il sito IIS deve puntare come "physical path" a questa cartella  public/  (non alla radice
      del progetto), cosi' che i file applicativi (.env, storage, ecc.) NON siano web-esposti.
    - HTTPS OBBLIGATORIO (i Service Worker/PWA funzionano solo in https o su localhost, §2-bis.2).
    - storage/ e bootstrap/cache/ scrivibili dall'Application Pool (IIS_IUSRS o identita' dedicata).
-->
<configuration>
    <system.webServer>

        <!-- index.php come documento di default. -->
        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>

        <rewrite>
            <rules>
                <!-- (Opzionale) Forza HTTPS. Scommentare in produzione se il redirect non e' gia'
                     gestito a monte (load balancer / binding IIS). -->
                <!--
                <rule name="Redirect to HTTPS" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions>
                        <add input="{HTTPS}" pattern="off" ignoreCase="true" />
                    </conditions>
                    <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
                </rule>
                -->

                <!-- Rimuove lo slash finale dalle URL che non sono directory. -->
                <rule name="Rimuovi slash finale" stopProcessing="true">
                    <match url="^(.*)/$" ignoreCase="false" />
                    <conditions>
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                    </conditions>
                    <action type="Redirect" redirectType="Permanent" url="/{R:1}" />
                </rule>

                <!-- Front controller: instrada verso index.php tutto cio' che non e' file/dir reale. -->
                <rule name="Front controller Laravel" stopProcessing="true">
                    <match url="^" ignoreCase="false" />
                    <conditions logicalGrouping="MatchAll">
                        <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
                        <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
                    </conditions>
                    <action type="Rewrite" url="index.php" />
                </rule>
            </rules>
        </rewrite>

        <!-- Sicurezza: nega l'accesso ai file nascosti (.env, .git, ecc.) se mai finissero in public/. -->
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment=".env" />
                    <add segment="storage" />
                    <add segment="vendor" />
                </hiddenSegments>
            </requestFiltering>
        </security>

        <!-- Cache degli asset statici buildati da Vite (hash nel nome file => cache lunga). -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
            <!-- Assicura il corretto MIME per il manifest PWA e i webmanifest (§8, Fase 6). -->
            <remove fileExtension=".webmanifest" />
            <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
            <remove fileExtension=".json" />
            <mimeMap fileExtension=".json" mimeType="application/json" />
        </staticContent>

        <httpProtocol>
            <customHeaders>
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
            </customHeaders>
        </httpProtocol>

    </system.webServer>
</configuration>
